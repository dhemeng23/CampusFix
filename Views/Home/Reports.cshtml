@model IEnumerable<campusfix.Models.Issue>

@{
    ViewData["Title"] = "Campus Reports";

    var issues = Model?.ToList() ?? new List<campusfix.Models.Issue>();
    var pendingCount = issues.Count(i => i.Status == "Pending");
    var progressCount = issues.Count(i => i.Status == "In Progress");
    var resolvedCount = issues.Count(i => i.Status == "Resolved");
}

<div class="reports-page">

    <!-- Page Header -->
    <section class="reports-header">
        <div>
            <span class="reports-eyebrow">CAMPUSFIX</span>
            <h1>Campus Reports</h1>
            <p>
                View, monitor and manage reported issues across the University of Ghana campus.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Report"
           class="reports-action">
            REPORT AN ISSUE
            <span>→</span>
        </a>
    </section>

    <!-- Summary Cards -->
    <section class="report-stats">

        <div class="report-stat-card">
            <div class="stat-icon">!</div>
            <div>
                <span class="stat-label">TOTAL REPORTS</span>
                <strong>@issues.Count</strong>
            </div>
        </div>

        <div class="report-stat-card">
            <div class="stat-icon pending-icon">◷</div>
            <div>
                <span class="stat-label">PENDING</span>
                <strong>@pendingCount</strong>
            </div>
        </div>

        <div class="report-stat-card">
            <div class="stat-icon progress-icon">↻</div>
            <div>
                <span class="stat-label">IN PROGRESS</span>
                <strong>@progressCount</strong>
            </div>
        </div>

        <div class="report-stat-card">
            <div class="stat-icon resolved-icon">✓</div>
            <div>
                <span class="stat-label">RESOLVED</span>
                <strong>@resolvedCount</strong>
            </div>
        </div>

    </section>

    <!-- Reports Table -->
    <section class="reports-panel">

        <div class="reports-panel-header">
            <div>
                <span class="reports-eyebrow">ISSUE TRACKER</span>
                <h2>Reported Issues</h2>
            </div>

            <span class="report-count">
                @issues.Count report@(issues.Count == 1 ? "" : "s")
            </span>
        </div>

        @if (!issues.Any())
        {
            <div class="empty-reports">
                <div class="empty-icon">✓</div>
                <h3>No reports yet</h3>
                <p>There are currently no reported campus issues.</p>
            </div>
        }
        else
        {
            <div class="reports-table-wrapper">
                <table class="reports-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>ISSUE</th>
                            <th>LOCATION</th>
                            <th>DESCRIPTION</th>
                            <th>STATUS</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var issue in issues)
                        {
                            <tr>
                                <td class="report-id">
                                    #@issue.Id
                                </td>

                                <td class="report-title">
                                    @issue.Title
                                </td>

                                <td>
                                    <span class="location-text">
                                        <span class="location-dot"></span>
                                        @issue.Location
                                    </span>
                                </td>

                                <td class="report-description">
                                    @issue.Description
                                </td>

                                <td>
                                    <span class="status-badge @issue.Status?.ToLower().Replace(" ", "-")">
    @issue.Status
</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </section>

</div>