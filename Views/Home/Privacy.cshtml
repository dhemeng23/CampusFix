@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-page">

    <div class="privacy-hero">
        <span class="section-label">CAMPUSFIX</span>
        <h1>Privacy Policy</h1>
        <p>
            Your privacy matters. CampusFix is designed to help the University
            community report, track and resolve campus issues responsibly.
        </p>
    </div>

    <div class="privacy-content">

        <div class="privacy-card">
            <div class="privacy-icon">🔒</div>
            <div>
                <h2>Your Information</h2>
                <p>
                    Information submitted through CampusFix is used to help
                    identify, track and manage issues reported across campus.
                </p>
            </div>
        </div>

        <div class="privacy-card">
            <div class="privacy-icon">📍</div>
            <div>
                <h2>Reported Issues</h2>
                <p>
                    Details such as the issue title, location and description
                    may be used to understand problems and support their resolution.
                </p>
            </div>
        </div>

        <div class="privacy-card">
            <div class="privacy-icon">🛡️</div>
            <div>
                <h2>Responsible Use</h2>
                <p>
                    CampusFix should be used responsibly. Please provide accurate
                    information when reporting an issue and avoid submitting
                    misleading or harmful content.
                </p>
            </div>
        </div>

        <div class="privacy-note">
            <strong>CampusFix</strong>
            <span>
                Built to keep the university community informed and make
                campus issues easier to report and follow.
            </span>
        </div>

    </div>

</div>